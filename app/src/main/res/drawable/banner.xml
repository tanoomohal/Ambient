<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="315" android:startColor="#FF0B0D12" android:endColor="#FF23283A" />
        </shape>
    </item>
    <item android:gravity="center" android:width="72dp" android:height="72dp">
        <shape android:shape="oval">
            <stroke android:width="5dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
</layer-list>
